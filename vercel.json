{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/flowforge",
      "destination": "/inventory-management",
      "permanent": true
    },
    {
      "source": "/company",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/websites/kevin-portfolio",
      "destination": "/websites/siddhants-world",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/smaya",
      "destination": "/TEMP%20Demo%20Page/"
    }
  ],
  "headers": [
    {
      "source": "/smaya",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/TEMP%20Demo%20Page/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
